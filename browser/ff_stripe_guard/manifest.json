{
  "manifest_version": 2,
  "name": "AI Hunter Sentinel — Privacy Guard",
  "version": "0.5.0",
  "description": "Blocks phishing domains, detects de-anonymization attempts, and routes Firefox through the AI Sentinel privacy proxy.",
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "notifications",
    "proxy",
    "storage"
  ],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmail_guard.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    "blocked.html",
    "brands.json",
    "icons/warn-48.png"
  ],
  "applications": {
    "gecko": { "id": "stripe-guard@aihunter", "strict_min_version": "91.0" }
  }
}
